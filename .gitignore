# ============================================================================
# sts2Mod 工作区 —— 根仓库忽略规则
#
# 追踪范围：本工作 mod（CznHeidemarie）+ 文档（AGENTS.md / *.md） + global.json
# 其余一律不追踪，按下面的分组逐条排除。
#
# 各 mod 子工程自己的忽略规则见 CznHeidemarie/.gitignore（Godot / .NET 产物）。
# ============================================================================


# ── 1. 操作系统 / 编辑器垃圾 ───────────────────────────────────────────────
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk


# ── 2. IDE 与 AI 工具的本地缓存（机器相关，不可复现）─────────────────────
/.vs/
/.vscode/
/.kilo/
/.workbuddy/
/.tmp/
/.codebuddy/
/.codegraph/


# ── 3. 嵌套 Git 仓库（各自独立管理，根仓库不感知、不追踪）────────────────
/openai-skills/
/SlayTheSpire2ModdingTutorials/


# ── 4. 大型只读参考区（外部来源，本仓库不收录）───────────────────────────
# 游戏本体反编译源码，约 2.9 GB / 2.7 万文件
/SlayTheSpire2_source/
# 卡厄思原始素材，只读公共区，约 703 MB
/CNZ_Source/
# 参考 mod A / B：GDRE 反编译产物，只读，约 460 MB
/CznTipheraCharacter/
/CznNineCharacter/
# Spine 动画查看器（约 289 MB）与场景检查器（约 73 MB）
/CZN_Viewer/
/CZN_AnimLab/
# RitsuLib 文档站（外部项目）
/STS2-RitsuLib-docs/

/skills/
/tools/
# ── 5. 构建产物与依赖缓存 ─────────────────────────────────────────────────
**/obj/
**/.godot/
**/.mono/
**/.nuget-feed/
**/.nuget-packages/
**/.stage_out/
**/bin/Debug/
**/bin/Release/
**/__pycache__/
*.py[cod]
*.user
*.pdb
*.pck
*.zip
*.cs.uid

# ── 6. 强制保留：CznHeidemarie/bin/ ───────────────────────────────────────
# ⚠️ 不要把 bin/ 加进忽略列表，也不要写 **/bin/。
# Godot 导出时会把 .gitignore 当作排除依据，忽略 bin/ 会让 spine 导入器
# 不参与导出，.skel/.atlas 连同 .spskel/.spatlas 一起从 pck 中丢失，
# 骨架动画彻底失效（实测 pck 会缩到 0.53 MB）。
# bin/ 是 spine-godot GDExtension 本体（46.9 MB），属于必需资源。
!/CznHeidemarie/bin/
