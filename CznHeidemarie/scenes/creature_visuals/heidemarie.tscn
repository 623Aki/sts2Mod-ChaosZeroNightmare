; 节点名必须是 Visuals：NCreatureVisuals._Ready 用 GetNode<Node2D>("%Visuals") 取本体，
; 名字不符会让 SpineBody 为 null，游戏 PushWarning 后彻底禁用动画。
[node name="Visuals" type="SpineSprite" parent="."]
unique_name_in_owner = true
skeleton_data_res = ExtResource("2_body")
; 30093.skel 只有 default 一个皮肤；默认动作/预览动画填骨架真实存在的 idle（放松待机）。
preview_skin = "default"
preview_animation = "idle"
preview_frame = false
preview_time = 0.0
position = Vector2(0, -20)
; 实测标定：30093.skel 的 b_idle 骨骼包围盒高 220.55（Spine 单位），
; 乘 1.247 约 275px，与参考 mod 的目标高度（Tiphera 274px / Nine 275px）一致。
scale = Vector2(1.247, 1.247)
metadata/heidemarie_scale_source = "b_idle 包围盒 220.55 x 188.68，比例 275/220.55 = 1.247；站位沿用参考 mod 的 (0,-20)。"

