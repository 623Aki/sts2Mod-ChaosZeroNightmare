; 背景变体三：角色大厅（对应设置里的「角色大厅」）。
; 由 CNZ 官方 30093.le 的 depth_infos 反转为 Godot 树的 back-to-front 顺序：
;   bg_b_03 → bg_b_02 → bg_b_01 → 主角 → bg_f_02 → bg_f_01 → fade
; 可见层统一播 lobby 循环动画；fade 层只有 1_intro_play，保持隐藏。
; 位置与缩放由 HeidemarieCharSelectBackgroundRuntime 按视口实时计算，
; 下面写的 (960,540)/1.5 只是 1920x1080 下的编辑器预览值。
[node name="HeidemarieLiveLobbyBg" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
metadata/heidemarie_layer_source = "direct official 30093.le depth_infos; Godot tree is back-to-front"

