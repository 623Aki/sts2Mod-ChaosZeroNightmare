; 背景变体二：动态立绘（对应设置里的「动态立绘」）。
;
; 由「破军（ux）」全屏演出用到的两张官方插画骨架叠成：
;   ux_illust_1 —— 后层
;   ux_illust_2 —— 前层
; 两张都按 intro → loop 的顺序播（见 metadata/czn_portrait_animation），
; 入场演完接循环，做出持续动感。
;
; 标定（设计坐标系 1920x1080，运行时按 cover 比例整体映射）：
;   两张骨架的包围盒分别是 934.45x622.90 与 938.57x741.68（原点在左下角）。
;   scale = max(1920/宽, 1080/高)，让它 cover 整个画面；
;   Y 再把多出来的高度上下均分，避免只裁到一半。

[node name="HeidemarieDynamicPortraitBg" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

